# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth (NextAuth)
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (for user login - increases daily credits from 3 to 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apollo.io API (people search)
APOLLO_API_KEY=

# Google Custom Search Engine (LinkedIn profile enrichment)
# Get these from: https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# OpenAI (competitor discovery + name extraction from search results)
OPENAI_API_KEY=
